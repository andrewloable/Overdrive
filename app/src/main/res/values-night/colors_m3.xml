<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 token palette — DARK theme.
  Generated from seed #00D4FF (BladeWatch brand cyan-blue). Surfaces follow
  M3 elevation tonal stepping (dim/bright + 5 container tiers) so we can stack
  two surfaces without needing elevation shadows that read poorly on dark.
  Generated with @material/material-color-utilities.
-->
