<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard — landscape variant (1920×1080 / ~960dp × 540dp).

  Layout:
    Top row: Trip stats hero (left, weight 3) ║ Connect card (right, weight 2)
    Bottom row: Status chips + metric tiles (scrollable)

  All IDs match the portrait layout so DashboardFragment binds unchanged.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ================== TOP ROW: TRIP STATS ║ CONNECT ================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_top"
        android:baselineAligned="false">

        <!-- TRIP STATS HERO (left, dominant) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tripStatsCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/card_radius_hero"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_hero"
                android:gravity="center_vertical">

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_trips_this_week"
                        android:letterSpacing="0.10"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllTrips"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/dashboard_trips_view_all"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>

                <!-- Primary headline -->
                <TextView
                    android:id="@+id/tvTripHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/dashboard_trips_loading"
                    android:textAppearance="@style/TextAppearance.BladeWatch.HeadlineMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <!-- Three sub-stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatTrips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_metric_value_pending"
                            android:textAppearance="@style/TextAppearance.BladeWatch.HeadlineSmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_trips_label_trips"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/colorOnPrimaryContainer"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:id="@+id/tvStatDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_metric_value_pending"
                            android:textAppearance="@style/TextAppearance.BladeWatch.HeadlineSmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_trips_label_distance"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/colorOnPrimaryContainer"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:id="@+id/tvStatDriveTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_metric_value_pending"
                            android:textAppearance="@style/TextAppearance.BladeWatch.HeadlineSmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_trips_label_time"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.7" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CONNECT CARD (right) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/card_radius_hero"
            app:cardElevation="0dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_hero">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dashboard_scan_to_connect"
                            android:textAppearance="@style/TextAppearance.BladeWatch.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvDeviceId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="@string/dashboard_device_id_loading"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textIsSelectable="true" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTunnels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="8dp" />

                    <FrameLayout
                        android:id="@+id/qrCodeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:background="?attr/colorSurfaceContainerLowest"
                        android:padding="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivQrCode"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="@android:color/white"
                            android:contentDescription="@string/cd_qr_code"
                            android:padding="6dp"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvQrPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/dashboard_qr_waiting"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:maxWidth="240dp"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textIsSelectable="true"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/dashboard_access_code"
                        android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/colorSurfaceContainerLow"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvDeviceToken"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.12"
                            android:singleLine="true"
                            android:text="@string/dashboard_token_masked"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:id="@+id/btnToggleToken"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_show_hide_token"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <ImageView
                            android:id="@+id/btnCopyToken"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_copy_token"
                            android:padding="4dp"
                            android:src="@drawable/ic_copy"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetPassword"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@string/cd_set_password"
                            android:text="@string/dashboard_set_password"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenerateToken"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/dashboard_regenerate_token"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ================== BOTTOM SCROLLABLE: STATUS + METRICS ================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding_horizontal"
            android:paddingBottom="@dimen/page_padding_bottom">

            <!-- Status chips row (compact) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/heroChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/heroChipTunnel"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/dashboard_tunnel_offline"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/heroChipServices"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/dashboard_daemons_running_default"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/heroChipRecording"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/dashboard_metric_recordings"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipStrokeWidth="0dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Metrics row: 5-up horizontal (Recordings | Tunnel | Services | Live | Vehicle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/card_gap_vertical"
                android:baselineAligned="false">

                <!-- Recordings -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/metricRecordings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minHeight="100dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="@dimen/card_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_recording"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/metricRecordingsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dashboard_metric_value_pending"
                            android:textAppearance="@style/TextAppearance.BladeWatch.TitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/metricStorageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dashboard_metric_recordings"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tunnel -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/metricTunnel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:minHeight="100dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="@dimen/card_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                            <View
                                android:id="@+id/tunnelStateDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/status_dot_offline" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/metricTunnelValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dashboard_tunnel_offline"
                            android:textAppearance="@style/TextAppearance.BladeWatch.TitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_metric_tunnel"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Services -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDaemons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:minHeight="100dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="@dimen/card_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_services"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvDaemonsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dashboard_daemons_running_default"
                            android:textAppearance="@style/TextAppearance.BladeWatch.TitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_metric_services"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quickLive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:minHeight="100dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="@dimen/card_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_live"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/dashboard_action_live"
                            android:textAppearance="@style/TextAppearance.BladeWatch.TitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_action_live_subtitle"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Vehicle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/metricVehicle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:minHeight="100dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="@dimen/card_radius_standard"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_vehicle_control"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/metricVehicleValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dashboard_vehicle_tap_to_set"
                            android:textAppearance="@style/TextAppearance.BladeWatch.TitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/dashboard_metric_vehicle"
                            android:textAppearance="@style/TextAppearance.BladeWatch.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
