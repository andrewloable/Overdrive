# BladeWatch web e2e — live target configuration.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.

# Base URL of a running BladeWatch instance. Examples:
#   - zrok tunnel:  https://<unique-name>.share.zrok.io
#   - device LAN:   http://192.168.1.187:8080   (LAN HTTP must be enabled)
#   - adb forward:  http://127.0.0.1:8080        (after `adb forward tcp:8080 tcp:8080`)
BLADEWATCH_E2E_URL=https://your-tunnel.share.zrok.io

# The 8-character Access Code shown in the app: Dashboard → "Scan to Connect".
# The login page combines it with the device id: <deviceId>-<accessCode>.
BLADEWATCH_ACCESS_CODE=xxxxxxxx

# Optional: reuse an existing Chromium/Chrome binary instead of Playwright's
# managed download (path to the executable). Leave unset normally.
# PW_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
